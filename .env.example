# Copy these values into your shell or hosting provider's environment.
# The server reads process.env; it does not automatically load this file.
# FANTOM_PORT wins over a platform-provided PORT. A PORT of 0 falls back to 4000.

FANTOM_PORT=4000
HOST=0.0.0.0

# Use an exact web origin in any deployment that is not a trusted LAN.
# "*" is a development convenience so phones on the LAN can call the API.
CORS_ORIGIN=*

COUNTDOWN_MS=5000
RECONNECT_GRACE_MS=60000
FINISHED_MATCH_TTL_MS=600000
LOBBY_TTL_MS=14400000
CLEANUP_INTERVAL_MS=60000
MAX_PLAYERS=16
